---
const socials = [
  { label: 'GitHub', href: 'https://github.com/ezazahmed', icon: 'github' },
  { label: 'Twitter / X', href: 'https://x.com/ezazahmed', icon: 'twitter' },
  { label: 'RSS', href: '/rss.xml', icon: 'rss' },
];

const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <p class="copyright">
      &copy; {year} <a href="/">Ezaz Ahmed</a>. Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp;
      <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer">Tailwind</a>.
    </p>

    <nav aria-label="Social links" class="socials">
      {socials.map(({ label, href, icon }) => (
        <a
          href={href}
          aria-label={label}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="social-link"
        >
          {icon === 'github' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          )}
          {icon === 'twitter' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          )}
          {icon === 'rss' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
            </svg>
          )}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .dark footer { border-color: var(--color-dark-border); }

  .footer-inner {
    max-width: var(--canvas-max-w);
    margin-inline: auto;
    padding-inline: var(--canvas-px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .copyright {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .dark .copyright { color: var(--color-dark-text-secondary); }

  .copyright a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .copyright a:hover { color: var(--color-text-primary); }
  .dark .copyright a:hover { color: var(--color-dark-text-primary); }

  .socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring),
                color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  .dark .social-link { color: var(--color-dark-text-secondary); }

  .social-link:hover {
    transform: scale(1.12);
    color: var(--color-text-primary);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }

  .dark .social-link:hover {
    color: var(--color-dark-text-primary);
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
  }

  .social-link:active { transform: scale(0.9); }
</style>
