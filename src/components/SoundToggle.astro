---
import IconSoundOn from '../icons/IconSoundOn.astro';
import IconSoundOff from '../icons/IconSoundOff.astro';
---

<button
  id="sound-toggle"
  aria-label="Toggle sound"
  title="Toggle sound"
>
  <div class="icon-container">
    <IconSoundOn class="icon-sound-on" />
    <IconSoundOff class="icon-sound-off" />
  </div>
</button>

<script>
  import { playSound } from '../utils/sound';

  const btn = document.getElementById('sound-toggle');
  
  // Initialize sound state from localStorage
  const getSoundEnabled = () => {
    try {
      const stored = localStorage.getItem('soundEnabled');
      return stored === null ? true : stored === 'true';
    } catch {
      return true;
    }
  };

  let soundEnabled = getSoundEnabled();
  updateButton();

  function updateButton() {
    if (soundEnabled) {
      btn?.classList.add('muted');
    } else {
      btn?.classList.remove('muted');
    }
  }

  btn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    try { 
      localStorage.setItem('soundEnabled', soundEnabled ? 'true' : 'false');
    } catch {}
    updateButton();
  });

  // Make sound state globally accessible
  (window as any).soundEnabled = () => soundEnabled;

  // ── Global sound event listeners ──────────────────────────
  document.querySelectorAll<HTMLElement>('[data-sound="click"]').forEach((el) => {
    el.addEventListener('click', () => playSound('click'));
  });

  document.querySelectorAll<HTMLElement>('[data-sound="toggle"]').forEach((el) => {
    el.addEventListener('click', () => playSound('toggle'));
  });
</script>

<style>
  #sound-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring),
                background-color var(--duration-fast) var(--ease-smooth),
                color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) #sound-toggle {
    border-color: var(--color-dark-border);
    color: var(--color-dark-text-secondary);
  }

  #sound-toggle:hover {
    transform: scale(1.08);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    color: var(--color-text-primary);
  }

  :global(html.dark) #sound-toggle:hover {
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
    color: var(--color-dark-text-primary);
  }

  #sound-toggle:active {
    transform: scale(0.92);
  }

  /* Icon container */
  .icon-container {
    position: relative;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Icon visibility */
  .icon-sound-on,
  .icon-sound-off {
    position: absolute;
    inset: 0;
    transition: opacity var(--duration-fast) var(--ease-smooth);
    opacity: 0;
  }

  .icon-sound-off {
    opacity: 1;
  }

  #sound-toggle.muted .icon-container .icon-sound-on {
    opacity: 1;
  }

  #sound-toggle.muted .icon-container .icon-sound-off {
    opacity: 0;
  }
</style>
