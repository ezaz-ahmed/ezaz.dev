---
import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import RSSLink from './RSSLink.astro';

const navLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const pathname = Astro.url.pathname;
---

<header id="navbar">
  <div class="navbar-inner">
    <a href="/" class="logo" aria-label="ezaz.dev — home">
      <span class="logo-dot" aria-hidden="true"></span>
      ezaz.dev
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: pathname.startsWith(href) }]}
              data-sound="click"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="navbar-actions">
      <slot name="actions" />
      <RSSLink />
      <ThemeToggle />
      <SoundToggle />
    </div>
  </div>
</header>

<script>
  // ── Scroll: add shadow when page is scrolled ──────────────
  const navbar = document.getElementById('navbar');
  const onScroll = () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    width: 100%;
    background-color: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: background-color var(--duration-base) var(--ease-smooth),
                box-shadow var(--duration-base) var(--ease-smooth),
                border-color var(--duration-base) var(--ease-smooth);
  }

  :global(html.dark) header {
    background-color: var(--color-dark-bg);
  }

  /* Scrolled: frosted glass */
  header.scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 16px color-mix(in srgb, var(--color-text-primary) 5%, transparent);
  }

  :global(html.dark) header.scrolled {
    background-color: color-mix(in srgb, var(--color-dark-bg) 70%, transparent);
    border-bottom-color: var(--color-dark-border);
    box-shadow: 0 1px 16px color-mix(in srgb, #000 30%, transparent);
  }

  .navbar-inner {
    max-width: var(--canvas-max-w);
    margin-inline: auto;
    padding-inline: var(--canvas-px);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-smooth),
                opacity var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .logo { color: var(--color-dark-text-primary); }
  .logo:hover { opacity: 0.75; }

  .logo-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    flex-shrink: 0;
  }

  :global(html.dark) .logo-dot {
    background: linear-gradient(135deg, var(--color-dark-accent-from), var(--color-dark-accent-to));
  }

  /* Nav */
  nav { flex: 1; }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    position: relative;
    transition: color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .nav-link { color: var(--color-dark-text-secondary); }

  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }

  :global(html.dark) .nav-link:hover {
    color: var(--color-dark-text-primary);
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
  }

  .nav-link.active {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  :global(html.dark) .nav-link.active { color: var(--color-dark-text-primary); }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0.75rem;
    right: 0.75rem;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-accent-from), var(--color-accent-to));
  }

  :global(html.dark) .nav-link.active::after {
    background: linear-gradient(90deg, var(--color-dark-accent-from), var(--color-dark-accent-to));
  }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
</style>