---
import site from '../data/site.json';
import type { Site } from '../lib/types';

const { owner, footerLinks } = site as Site;

const year = new Date().getFullYear();
---

<footer
  class="border-line text-ink-soft mt-20 flex justify-between border-t pt-6 font-mono text-[12px]"
>
  <span>© {year} {owner}</span>
  <span>
    {
      footerLinks.map((link, i) => (
        <>
          {i > 0 && ' · '}
          <a href={link.href} class="hover:text-accent no-underline">
            {link.label}
          </a>
        </>
      ))
    }
  </span>
</footer>
