---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout title="Blog" description="Engineering writings on the web, performance, interface craft, and systems thinking.">
  <div class="canvas blog-index">
    <header class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">
        Writings on software engineering, interface craft, and building things that matter.
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}.
      </p>
    </header>

    {allTags.length > 0 && (
      <div class="tag-filter" role="navigation" aria-label="Filter by tag">
        <a href="/blog" class="tag-chip active">All</a>
        {allTags.map((tag) => (
          <a href={`/blog/tag/${tag}`} class="tag-chip">{tag}</a>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <p class="empty-state">No posts yet. Check back soon.</p>
    ) : (
      <ul class="post-list" role="list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="post-row">
              <div class="post-row-meta">
                <time datetime={post.data.pubDate.toISOString()} class="post-date">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    month: 'short', day: 'numeric', year: 'numeric',
                  })}
                </time>
                <div class="post-tags">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <div class="post-row-content">
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-desc">{post.data.description}</p>
              </div>
              <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>

<style>
  .blog-index {
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary);
  }

  :global(html.dark) .page-title { color: var(--color-dark-text-primary); }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 52ch;
  }

  :global(html.dark) .page-subtitle { color: var(--color-dark-text-secondary); }

  /* Tag filter */
  .tag-filter {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.3em 0.875em;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: all var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .tag-chip {
    border-color: var(--color-dark-border);
    color: var(--color-dark-text-secondary);
  }

  .tag-chip:hover, .tag-chip.active {
    background: color-mix(in srgb, var(--color-accent-from) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-accent-from) 30%, transparent);
    color: var(--color-accent-from);
  }

  :global(html.dark) .tag-chip:hover,
  :global(html.dark) .tag-chip.active {
    background: color-mix(in srgb, var(--color-dark-accent-from) 15%, transparent);
    border-color: color-mix(in srgb, var(--color-dark-accent-from) 30%, transparent);
    color: var(--color-dark-accent-from);
  }

  /* Post list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 1.5rem;
    align-items: center;
    padding-block: 1.5rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--duration-fast) var(--ease-smooth);
    border-radius: 0.5rem;
    margin-inline: -1rem;
    padding-inline: 1rem;
  }

  :global(html.dark) .post-row { border-color: var(--color-dark-border); }

  .post-row:hover {
    background-color: color-mix(in srgb, var(--color-text-primary) 3%, transparent);
  }

  :global(html.dark) .post-row:hover {
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 4%, transparent);
  }

  .post-row-meta {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  :global(html.dark) .post-date { color: var(--color-dark-text-secondary); }

  .post-tags { display: flex; gap: 0.375rem; }

  .post-row-content {
    grid-column: 1;
    grid-row: 2;
  }

  .post-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem;
    letter-spacing: -0.015em;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .post-title { color: var(--color-dark-text-primary); }

  .post-row:hover .post-title {
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .post-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  :global(html.dark) .post-desc { color: var(--color-dark-text-secondary); }

  .arrow-icon {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--color-text-secondary);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-fast) var(--ease-smooth),
                transform var(--duration-fast) var(--ease-spring);
  }

  :global(html.dark) .arrow-icon { color: var(--color-dark-text-secondary); }

  .post-row:hover .arrow-icon {
    opacity: 1;
    transform: translateX(0);
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  :global(html.dark) .empty-state { color: var(--color-dark-text-secondary); }
</style>
