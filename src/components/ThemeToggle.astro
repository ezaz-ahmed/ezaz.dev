---
import IconSun from '../icons/IconSun.astro';
import IconMoon from '../icons/IconMoon.astro';
---

<button
  id="theme-toggle"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  data-sound="toggle"
>
  <div class="icon-container">
    <IconSun class="icon-sun" />
    <IconMoon class="icon-moon" />
  </div>
</button>

<script>
  import { playSound } from '../utils/sound';

  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    playSound('toggle');
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
  });
</script>

<style>
  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring),
                background-color var(--duration-fast) var(--ease-smooth),
                color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) #theme-toggle {
    border-color: var(--color-dark-border);
    color: var(--color-dark-text-secondary);
  }

  #theme-toggle:hover {
    transform: scale(1.08);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    color: var(--color-text-primary);
  }

  :global(html.dark) #theme-toggle:hover {
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
    color: var(--color-dark-text-primary);
  }

  #theme-toggle:active { transform: scale(0.92); }

  /* Icon container */
  .icon-container {
    position: relative;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Icon visibility */
  .icon-sun,
  .icon-moon {
    position: absolute;
    inset: 0;
    transition: opacity var(--duration-fast) var(--ease-smooth);
  }

  .icon-sun {
    opacity: 1;
  }

  .icon-moon {
    opacity: 0;
  }

  :global(html.dark) .icon-sun {
    opacity: 0;
  }

  :global(html.dark) .icon-moon {
    opacity: 1;
  }
</style>
