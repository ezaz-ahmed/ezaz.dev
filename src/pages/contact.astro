---
import Layout from '../layouts/Layout.astro';

const links = [
  {
    label: 'GitHub',
    handle: '@ezazahmed',
    href: 'https://github.com/ezazahmed',
    description: 'Open source work and personal projects',
    icon: 'github',
  },
  {
    label: 'Twitter / X',
    handle: '@ezazahmed',
    href: 'https://x.com/ezazahmed',
    description: 'Thoughts, links, and short-form writing',
    icon: 'twitter',
  },
  {
    label: 'Email',
    handle: 'hello@ezaz.dev',
    href: 'mailto:hello@ezaz.dev',
    description: 'For collaboration, consulting, or just saying hi',
    icon: 'mail',
  },
  {
    label: 'RSS Feed',
    handle: '/rss.xml',
    href: '/rss.xml',
    description: 'Subscribe to new posts in your reader',
    icon: 'rss',
  },
];
---

<Layout
  title="Contact"
  description="Get in touch — find me on GitHub, Twitter, or drop me an email."
>
  <div class="canvas contact-page">
    <header class="page-header">
      <h1 class="page-title">Get in touch</h1>
      <p class="page-subtitle">
        The best way to reach me is via email or Twitter. I try to respond to every message.
      </p>
    </header>

    <ul class="link-list" role="list">
      {links.map(({ label, handle, href, description, icon }) => (
        <li>
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="link-card surface card-hover"
          >
            <div class="link-icon-wrap accent-gradient" aria-hidden="true">
              {icon === 'github' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
              )}
              {icon === 'twitter' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
              {icon === 'mail' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              )}
              {icon === 'rss' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
              )}
            </div>

            <div class="link-content">
              <div class="link-header">
                <span class="link-label">{label}</span>
                <span class="link-handle">{handle}</span>
              </div>
              <p class="link-description">{description}</p>
            </div>

            <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .contact-page { padding-bottom: 5rem; }

  .page-header { margin-bottom: 2.5rem; }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary);
  }

  :global(html.dark) .page-title { color: var(--color-dark-text-primary); }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 52ch;
  }

  :global(html.dark) .page-subtitle { color: var(--color-dark-text-secondary); }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0.875rem;
    text-decoration: none;
  }

  .link-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }

  .link-content { flex: 1; min-width: 0; }

  .link-header {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  .link-label {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
  }

  :global(html.dark) .link-label { color: var(--color-dark-text-primary); }

  .link-handle {
    font-size: 0.825rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  :global(html.dark) .link-handle { color: var(--color-dark-text-secondary); }

  .link-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  :global(html.dark) .link-description { color: var(--color-dark-text-secondary); }

  .arrow-icon {
    color: var(--color-text-secondary);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-fast) var(--ease-smooth),
                transform var(--duration-fast) var(--ease-spring);
  }

  :global(html.dark) .arrow-icon { color: var(--color-dark-text-secondary); }

  .link-card:hover .arrow-icon {
    opacity: 1;
    transform: translateX(0);
  }
</style>
