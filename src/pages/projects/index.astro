---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---

<Layout
  title="Projects"
  description="A selection of software projects — from developer tools and open-source libraries to side experiments."
>
  <div class="canvas projects-page">
    <header class="page-header">
      <h1 class="page-title">Projects</h1>
      <p class="page-subtitle">
        Software I've built — tools, experiments, and things that scratched an itch.
      </p>
    </header>

    {allTags.length > 0 && (
      <div class="tag-filter">
        {allTags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <ul class="project-grid" role="list">
      {projects.map((project) => (
        <li id={project.id}>
          <article class="project-card surface card-hover">
            <div class="project-card-top">
              <div class="project-card-header">
                <h2 class="project-title">{project.data.title}</h2>
                <div class="project-links">
                  {project.data.url && (
                    <a
                      href={project.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Visit ${project.data.title}`}
                      class="icon-link"
                      title="Visit site"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  )}
                  {project.data.repo && (
                    <a
                      href={project.data.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.data.title} on GitHub`}
                      class="icon-link"
                      title="View source"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                    </a>
                  )}
                </div>
              </div>
              <p class="project-desc">{project.data.description}</p>
            </div>
            <div class="project-tags">
              {project.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .projects-page { padding-bottom: 5rem; }

  .page-header { margin-bottom: 2.5rem; }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 0 0.75rem;
    color: var(--color-text-primary);
  }

  :global(html.dark) .page-title { color: var(--color-dark-text-primary); }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 52ch;
  }

  :global(html.dark) .page-subtitle { color: var(--color-dark-text-secondary); }

  .tag-filter {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .project-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 0.875rem;
    height: 100%;
  }

  .project-card-top { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }

  .project-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.015em;
  }

  :global(html.dark) .project-title { color: var(--color-dark-text-primary); }

  .project-links {
    display: flex;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring),
                color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .icon-link { color: var(--color-dark-text-secondary); }

  .icon-link:hover {
    transform: scale(1.12);
    color: var(--color-text-primary);
    background-color: color-mix(in srgb, var(--color-text-primary) 8%, transparent);
  }

  :global(html.dark) .icon-link:hover {
    color: var(--color-dark-text-primary);
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 10%, transparent);
  }

  .project-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  :global(html.dark) .project-desc { color: var(--color-dark-text-secondary); }

  .project-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
</style>
