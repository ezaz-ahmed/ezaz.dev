---
import work from '../data/work.json';
import type { Work } from '../lib/types';
import FeaturedProject from './FeaturedProject.astro';
import GithubStats from './GithubStats.astro';
import AvailabilityCard from './ui/AvailabilityCard.astro';
import ProjectCard from './ui/ProjectCard.astro';
import SectionHeading from './ui/SectionHeading.astro';
import StackMarquee from './ui/StackMarquee.astro';

const { heading, featured, projects, rotation, availability } = work as Work;
---

<section id="work" class="mt-25 flex scroll-mt-4 flex-col pt-8 lg:h-svh lg:max-h-220 lg:min-h-160">
  <SectionHeading title={heading} />

  <div
    class="grid min-h-0 flex-1 auto-rows-[minmax(170px,auto)] grid-cols-1 gap-3.5 sm:grid-cols-2 lg:auto-rows-auto lg:grid-cols-6 lg:grid-rows-6"
  >
    <FeaturedProject {...featured} class="sm:col-span-2 lg:col-span-4 lg:row-span-4" />

    <GithubStats class="lg:col-span-2 lg:row-span-2" />

    <StackMarquee items={rotation} class="lg:col-span-2 lg:row-span-2" />

    {projects.map((project) => <ProjectCard {...project} class="lg:col-span-2 lg:row-span-2" />)}

    <AvailabilityCard {...availability} class="sm:col-span-2 lg:col-span-2 lg:row-span-2" />
  </div>
</section>
