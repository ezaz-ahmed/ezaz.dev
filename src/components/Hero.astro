---
import hero from '../data/hero.json';
import type { Hero } from '../lib/types';
import Button from './ui/Button.astro';

const { status, name, intro, bubble, avatar, actions } = hero as Hero;
---

<section
  class="flex min-h-[calc(100svh-5.5rem)] flex-col-reverse items-start justify-center gap-10 pb-16 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
>
  <div class="min-w-0">
    <span
      class="bg-tag-teal-bg text-tag-teal mb-9 inline-block rounded-[3px] px-2.5 py-1 font-mono text-[13px]"
    >
      {status}
    </span>

    <h1
      class="mb-8 font-mono text-[44px] leading-[1.15] font-extrabold tracking-[-0.5px] max-[560px]:text-[32px]"
    >
      {name}<span class="cursor"></span>
    </h1>

    {/* Copy arrives as runs of text so the emphasis lives in data, not markup. */}
    <p class="text-ink-soft mb-11 max-w-130 text-[17px] leading-[1.65]">
      {
        intro.map((part) =>
          part.strong ? <strong class="text-ink font-semibold">{part.text}</strong> : part.text
        )
      }
    </p>

    <div class="flex gap-4">
      {
        actions.map((cta) => (
          <Button href={cta.href} variant={cta.variant}>
            {cta.label}
          </Button>
        ))
      }
    </div>
  </div>

  <!-- self-center only bites while stacked (cross axis is horizontal there) -->
  <div class="group relative shrink-0 self-center sm:self-auto">
    <!-- Comic speech bubble: hidden until image is hovered -->
    <div
      class="pointer-events-none absolute -top-2 left-1/2 z-10 w-50 -translate-x-1/2 -translate-y-full scale-95 opacity-0 transition-all duration-200 ease-out group-hover:-translate-y-[calc(100%+8px)] group-hover:scale-100 group-hover:opacity-100"
    >
      <div
        class="border-ink bg-paper-raised relative rounded-[10px] border-2 px-3 py-2 text-center font-mono text-[12px] leading-[1.45] shadow-[2px_3px_0_var(--color-shadow)]"
      >
        {bubble}
        <!-- tail -->
        <span
          class="border-ink bg-paper-raised absolute bottom-0 left-1/2 h-3 w-3 -translate-x-1/2 translate-y-1/2 rotate-45 border-r-2 border-b-2"
        ></span>
      </div>
    </div>

    <img
      src={avatar.src}
      width="200"
      height="200"
      alt={avatar.alt}
      loading="eager"
      class="h-auto w-32.5 -rotate-10 rounded-xs shadow-[5px_5px_0_var(--color-shadow)] transition-transform duration-300 ease-out group-hover:rotate-0 sm:w-42.5 lg:w-50"
    />
  </div>
</section>
