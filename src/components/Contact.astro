---
/*
  Contact form. Every control is its own ui/ component — this file owns nothing
  but the copy source, the grid, and which component each field maps to.
*/
import contact from '../data/contact.json';
import type { ContactContent } from '../lib/types';
import Button from './ui/Button.astro';
import EmailInput from './ui/EmailInput.astro';
import SectionHeading from './ui/SectionHeading.astro';
import SelectInput from './ui/SelectInput.astro';
import TextArea from './ui/TextArea.astro';
import TextInput from './ui/TextInput.astro';

const { heading, intro, action, method, submitLabel, fields } = contact as ContactContent;
---

<section class="mt-10 pt-8" id="contact">
  <SectionHeading title={heading} />

  <p class="text-ink-soft mb-7 max-w-130 text-[15px] leading-[1.65]">
    {/* Explicit space: the copy and the marker sit on separate source lines. */}
    {intro}{' '}<span class="text-accent">*</span>.
  </p>

  <form {action} {method} class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <TextInput {...fields.name} />
    <EmailInput {...fields.email} />
    <TextInput {...fields.company} />
    <SelectInput {...fields.subject} />
    <TextArea {...fields.message} class="sm:col-span-2" />

    <div class="sm:col-span-2">
      <Button type="submit" size="md" arrow>{submitLabel}</Button>
    </div>
  </form>
</section>
