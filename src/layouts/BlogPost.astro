---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description}>
  <article class="blog-post">
    <header class="post-header canvas">
      <div class="post-meta">
        <a href="/blog" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          All posts
        </a>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {formattedUpdated && (
          <span class="updated-note">Updated {formattedUpdated}</span>
        )}
      </div>

      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>

      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="post-body canvas prose">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    width: 100%;
  }

  .post-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(html.dark) .post-header {
    border-color: var(--color-dark-border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
  }

  :global(html.dark) .post-meta {
    color: var(--color-dark-text-secondary);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .back-link { color: var(--color-dark-text-secondary); }
  .back-link:hover { color: var(--color-text-primary); }
  :global(html.dark) .back-link:hover { color: var(--color-dark-text-primary); }

  .back-link::before { content: ''; flex-shrink: 0; }

  .updated-note {
    font-style: italic;
    font-size: 0.8125rem;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    color: var(--color-text-primary);
  }

  :global(html.dark) .post-title { color: var(--color-dark-text-primary); }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }

  :global(html.dark) .post-description { color: var(--color-dark-text-secondary); }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-body {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }
</style>
