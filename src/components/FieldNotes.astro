---
import notesData from '../data/notes.json';
import type { Note } from '../lib/types';
import SectionHeading from './ui/SectionHeading.astro';

const { heading, notes } = notesData as { heading: string; notes: Note[] };
---

<section class="mt-25 pt-8" id="writing">
  <SectionHeading title={heading} />

  {
    notes.map((note) => (
      <div class="border-line grid grid-cols-[74px_1fr] gap-4.5 border-b border-dashed py-4 first:border-t first:border-dashed max-[560px]:grid-cols-1">
        <div class="text-accent pt-0.5 font-mono text-[13px] font-bold max-[560px]:pt-0">
          {note.hash}
        </div>
        <div>
          <div class="text-ink-soft mb-1.5 flex items-center gap-2.5 font-mono text-[11.5px]">
            <span>{note.date}</span>
            <span class="bg-tag-teal-bg text-tag-teal rounded-[3px] px-1.75 py-0.5">
              {note.tag}
            </span>
          </div>
          <h3 class="mb-1.5 text-[16px] font-semibold">
            <a
              href={note.href}
              class="hover:decoration-accent no-underline hover:underline hover:decoration-2"
            >
              {note.title}
            </a>
          </h3>
          <p class="text-ink-soft text-[14px] leading-[1.6]">{note.desc}</p>
        </div>
      </div>
    ))
  }
</section>
