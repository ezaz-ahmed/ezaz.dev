---
interface DataPoint {
  label: string;
  value: number; // 0–100
}

interface Props {
  title?: string;
  data: DataPoint[];
  unit?: string;
}

const { title, data, unit = '' } = Astro.props;
const max = Math.max(...data.map((d) => d.value), 1);

// Unique ID so multiple widgets on the same page don't collide
const uid = `dvw-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class="data-viz" id={uid} aria-label={title ?? 'Data visualization'}>
  {title && <figcaption class="viz-title">{title}</figcaption>}

  <div class="viz-chart" role="img" aria-label={data.map((d) => `${d.label}: ${d.value}${unit}`).join(', ')}>
    {data.map(({ label, value }) => {
      const pct = (value / max) * 100;
      return (
        <div class="viz-row">
          <span class="viz-label">{label}</span>
          <div class="viz-bar-track">
            <div
              class="viz-bar"
              style={`--target-width: ${pct}%`}
              data-animate
            ></div>
            <span class="viz-value">{value}{unit}</span>
          </div>
        </div>
      );
    })}
  </div>
</figure>

<script>
  // Animate bars when they scroll into view
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const bars = entry.target.querySelectorAll<HTMLElement>('.viz-bar[data-animate]');
        bars.forEach((bar, i) => {
          bar.style.transitionDelay = `${i * 60}ms`;
          bar.classList.add('visible');
        });
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.25 },
  );

  document.querySelectorAll<HTMLElement>('.data-viz').forEach((el) => observer.observe(el));
</script>

<style>
  .data-viz {
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    border-radius: 0.875rem;
    padding: 1.5rem;
    margin-block: 1.75em;
  }

  :global(html.dark) .data-viz {
    background-color: var(--color-dark-surface);
    border-color: var(--color-dark-border);
  }

  .viz-title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    display: block;
  }

  :global(html.dark) .viz-title { color: var(--color-dark-text-primary); }

  .viz-chart {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .viz-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 0.875rem;
  }

  @media (max-width: 480px) {
    .viz-row { grid-template-columns: 7rem 1fr; }
  }

  .viz-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(html.dark) .viz-label { color: var(--color-dark-text-secondary); }

  .viz-bar-track {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    height: 10px;
  }

  .viz-bar-track::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 2.5rem;
    border-radius: 5px;
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }

  :global(html.dark) .viz-bar-track::before {
    background: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
  }

  .viz-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    max-width: calc(100% - 2.5rem);
    border-radius: 5px;
    background: linear-gradient(90deg, var(--color-accent-from), var(--color-accent-to));
    transition: width 700ms var(--ease-smooth);
  }

  :global(html.dark) .viz-bar {
    background: linear-gradient(90deg, var(--color-dark-accent-from), var(--color-dark-accent-to));
  }

  .viz-bar.visible {
    width: var(--target-width);
  }

  .viz-value {
    position: absolute;
    right: 0;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  :global(html.dark) .viz-value { color: var(--color-dark-text-primary); }
</style>
