---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// All tags with post counts
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
});

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout
  title={`#${tag} — Blog`}
  description={`All posts tagged with "${tag}".`}
>
  <div class="canvas tag-page">
    <header class="page-header">
      <a href="/blog" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        All posts
      </a>
      <div class="tag-hero">
        <span class="tag">{tag}</span>
        <h1 class="page-title">#{tag}</h1>
        <p class="page-subtitle">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      </div>
    </header>

    <ul class="post-list" role="list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="post-row surface card-hover">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()} class="post-date">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short', day: 'numeric', year: 'numeric',
                })}
              </time>
            </div>
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .tag-page { padding-bottom: 5rem; }

  .page-header { margin-bottom: 2.5rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .back-link { color: var(--color-dark-text-secondary); }
  .back-link:hover { color: var(--color-text-primary); }
  :global(html.dark) .back-link:hover { color: var(--color-dark-text-primary); }

  .tag-hero { display: flex; flex-direction: column; gap: 0.5rem; }

  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0.5rem 0 0;
    color: var(--color-text-primary);
  }

  :global(html.dark) .page-title { color: var(--color-dark-text-primary); }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  :global(html.dark) .page-subtitle { color: var(--color-dark-text-secondary); }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-row {
    display: block;
    padding: 1.25rem 1.5rem;
    border-radius: 0.875rem;
    text-decoration: none;
  }

  .post-meta { margin-bottom: 0.4rem; }

  .post-date {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  :global(html.dark) .post-date { color: var(--color-dark-text-secondary); }

  .post-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem;
    letter-spacing: -0.015em;
  }

  :global(html.dark) .post-title { color: var(--color-dark-text-primary); }

  .post-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  :global(html.dark) .post-desc { color: var(--color-dark-text-secondary); }
</style>
