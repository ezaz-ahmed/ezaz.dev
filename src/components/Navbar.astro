---
const navLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const pathname = Astro.url.pathname;
---

<header id="navbar">
  <div class="navbar-inner">
    <a href="/" class="logo" aria-label="ezaz.dev — home">
      <span class="logo-dot" aria-hidden="true"></span>
      ezaz.dev
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: pathname.startsWith(href) }]}
              data-sound="click"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="navbar-actions">
      <slot name="actions" />
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        data-sound="toggle"
      >
        {/* Sun icon — shown in dark mode */}
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        {/* Moon icon — shown in light mode */}
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { playSound } from '../utils/sound';

  // ── Theme toggle ──────────────────────────────────────────
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    playSound('toggle');
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
  });

  // ── Nav link sound cues ───────────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-sound="click"]').forEach((el) => {
    el.addEventListener('click', () => playSound('click'));
  });

  // ── Scroll: add shadow when page is scrolled ──────────────
  const navbar = document.getElementById('navbar');
  const onScroll = () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    width: 100%;
    transition: background-color var(--duration-base) var(--ease-smooth),
                box-shadow var(--duration-base) var(--ease-smooth),
                border-color var(--duration-base) var(--ease-smooth);
    background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border-bottom: 1px solid transparent;
  }

  .dark header {
    background-color: color-mix(in srgb, var(--color-dark-bg) 75%, transparent);
  }

  header.scrolled {
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 16px color-mix(in srgb, var(--color-text-primary) 5%, transparent);
  }

  .dark header.scrolled {
    border-bottom-color: var(--color-dark-border);
    box-shadow: 0 1px 16px color-mix(in srgb, #000 25%, transparent);
  }

  .navbar-inner {
    max-width: var(--canvas-max-w);
    margin-inline: auto;
    padding-inline: var(--canvas-px);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--duration-fast) var(--ease-smooth);
  }

  .dark .logo { color: var(--color-dark-text-primary); }
  .logo:hover { opacity: 0.75; }

  .logo-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-from), var(--color-accent-to));
    flex-shrink: 0;
  }

  /* Nav */
  nav {
    flex: 1;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    position: relative;
    transition: color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  .dark .nav-link { color: var(--color-dark-text-secondary); }

  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }

  .dark .nav-link:hover {
    color: var(--color-dark-text-primary);
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
  }

  /* Active underline */
  .nav-link.active {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .dark .nav-link.active { color: var(--color-dark-text-primary); }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0.75rem;
    right: 0.75rem;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-accent-from), var(--color-accent-to));
  }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  /* Theme toggle button */
  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring),
                background-color var(--duration-fast) var(--ease-smooth),
                color var(--duration-fast) var(--ease-smooth);
  }

  .dark #theme-toggle {
    border-color: var(--color-dark-border);
    color: var(--color-dark-text-secondary);
  }

  #theme-toggle:hover {
    transform: scale(1.08);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    color: var(--color-text-primary);
  }

  .dark #theme-toggle:hover {
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
    color: var(--color-dark-text-primary);
  }

  #theme-toggle:active { transform: scale(0.92); }

  /* Icon visibility */
  .icon-sun  { display: none; }
  .icon-moon { display: block; }

  :global(html.dark) .icon-sun  { display: block; }
  :global(html.dark) .icon-moon { display: none; }
</style>
