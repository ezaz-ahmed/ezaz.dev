---
import IconRSS from '../icons/IconRSS.astro';
---

<a
  href="/rss.xml"
  class="rss-link"
  aria-label="RSS feed"
  title="RSS feed"
>
  <div class="icon-container">
    <IconRSS />
  </div>
</a>

<style>
  .rss-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring),
                background-color var(--duration-fast) var(--ease-smooth),
                color var(--duration-fast) var(--ease-smooth);
  }

  :global(html.dark) .rss-link {
    border-color: var(--color-dark-border);
    color: var(--color-dark-text-secondary);
  }

  .rss-link:hover {
    transform: scale(1.08);
    background-color: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    color: var(--color-text-primary);
  }

  :global(html.dark) .rss-link:hover {
    background-color: color-mix(in srgb, var(--color-dark-text-primary) 8%, transparent);
    color: var(--color-dark-text-primary);
  }

  .rss-link:active { transform: scale(0.92); }

  /* Icon container */
  .icon-container {
    position: relative;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
