---
interface Props {
  type?: 'tip' | 'info' | 'warning' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  tip:     { label: title ?? 'Tip',     emoji: '💡' },
  info:    { label: title ?? 'Note',    emoji: 'ℹ️' },
  warning: { label: title ?? 'Warning', emoji: '⚠️' },
  danger:  { label: title ?? 'Danger',  emoji: '🚨' },
} as const;

const { label, emoji } = config[type];
---

<aside class:list={['callout', `callout--${type}`]} role="note">
  <div class="callout-header">
    <span class="callout-emoji" aria-hidden="true">{emoji}</span>
    <span class="callout-label">{label}</span>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    position: relative;
    border-radius: 0.75rem;
    padding: 1.125rem 1.25rem 1.125rem 1.25rem;
    margin-block: 1.75em;
    border: 1px solid transparent;
    overflow: hidden;
    isolation: isolate;
  }

  /* Mesh gradient backdrop */
  .callout::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.07;
    border-radius: inherit;
  }

  /* Left accent bar */
  .callout::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 3px 0 0 3px;
  }

  /* ── Variants ── */
  .callout--tip {
    background: color-mix(in srgb, #22c55e 8%, transparent);
    border-color: color-mix(in srgb, #22c55e 20%, transparent);
  }
  .callout--tip::after { background: #22c55e; }
  .callout--tip .callout-label { color: #16a34a; }

  .callout--info {
    background: color-mix(in srgb, #6366F1 8%, transparent);
    border-color: color-mix(in srgb, #6366F1 20%, transparent);
  }
  .callout--info::after { background: #6366F1; }
  .callout--info .callout-label { color: #4f46e5; }

  .callout--warning {
    background: color-mix(in srgb, #f59e0b 8%, transparent);
    border-color: color-mix(in srgb, #f59e0b 20%, transparent);
  }
  .callout--warning::after { background: #f59e0b; }
  .callout--warning .callout-label { color: #b45309; }

  .callout--danger {
    background: color-mix(in srgb, #ef4444 8%, transparent);
    border-color: color-mix(in srgb, #ef4444 20%, transparent);
  }
  .callout--danger::after { background: #ef4444; }
  .callout--danger .callout-label { color: #dc2626; }

  /* ── Dark mode adjustments ── */
  :global(html.dark) .callout--tip    { background: color-mix(in srgb, #22c55e 10%, transparent); }
  :global(html.dark) .callout--tip    .callout-label { color: #4ade80; }
  :global(html.dark) .callout--info   { background: color-mix(in srgb, #818CF8 10%, transparent); }
  :global(html.dark) .callout--info   .callout-label { color: #818CF8; }
  :global(html.dark) .callout--warning { background: color-mix(in srgb, #fbbf24 10%, transparent); }
  :global(html.dark) .callout--warning .callout-label { color: #fbbf24; }
  :global(html.dark) .callout--danger  { background: color-mix(in srgb, #f87171 10%, transparent); }
  :global(html.dark) .callout--danger  .callout-label { color: #f87171; }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .callout-emoji {
    font-size: 1rem;
    line-height: 1;
  }

  .callout-label {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .callout-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-primary);
  }

  :global(html.dark) .callout-body { color: var(--color-dark-text-primary); }

  .callout-body :global(p:last-child) { margin-bottom: 0; }
  .callout-body :global(p) { margin: 0 0 0.75em; }
</style>
